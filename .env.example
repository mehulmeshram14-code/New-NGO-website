# Copy to .env.local for local development. Never commit real values.

# Public site URL (used for canonical / social-share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB connection. If empty, donations are kept in an in-memory store
# that is wiped on every restart — fine for local testing, NOT for production.
MONGODB_URI=

# Razorpay (Dashboard → Account & Settings → API Keys / Webhooks).
# Without these, /campaign/hunger-free cannot take payments.
# Never prefix the secrets with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
