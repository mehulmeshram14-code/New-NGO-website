# ==============================================================================
# DeepRoots Foundation - Environment Configuration Template
# Copy this file to `.env.local` for local development.
# NEVER commit real credentials, database strings, or payment secrets to Git!
# ==============================================================================

# MongoDB Atlas Connection
# Leave empty or omit in dev mode to use the built-in resilient in-memory mock store
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/deeproots_ngo?retryWrites=true&w=majority
MONGODB_URI=

# Application Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment Integration (Razorpay)
# When left blank, the platform defaults to verified Bank Transfer / UPI flow,
# and Razorpay runs in test/sandbox simulation mode without charging real cards.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Organisation Bank Details for Direct Manual Transfers (Displayed in donation flow)
NEXT_PUBLIC_UPI_ID=deeproots@upi
NEXT_PUBLIC_BANK_NAME=State Bank of India
NEXT_PUBLIC_ACCOUNT_NAME=DeepRoots Foundation
NEXT_PUBLIC_ACCOUNT_NUMBER=40123456789
NEXT_PUBLIC_IFSC_CODE=SBIN0000312
NEXT_PUBLIC_BANK_BRANCH=Amravati Main Branch, Maharashtra

# Admin Secret Key for accessing the verification & reporting portal (/admin)
# Set a strong alphanumeric passphrase in production
ADMIN_SECRET_KEY=deeproots_admin_2026

# Email Notification Service (e.g. Resend / SendGrid / Postmark)
# If unconfigured, confirmation slips are generated and downloadable directly on-screen
EMAIL_SERVICE_API_KEY=
EMAIL_FROM="DeepRoots Foundation <acknowledgements@deeprootsfoundation.org>"
